# Long random string. Required for sessions.
SESSION_SECRET=

# Public site URL used for payment return links, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe test keys. Checkout stays unpaid until these are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Password reset email is logged in development when these are empty.
RESEND_API_KEY=
RESEND_FROM=

# Optional. Used only when seeding accounts in production.
SEED_CUSTOMER_PASSWORD=
SEED_ADMIN_PASSWORD=
